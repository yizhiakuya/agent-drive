# Agent Drive 环境配置（复制为 .env 使用）
# 注：LLM 的 API Key 由 Agent 自管理存于 system/agent-config.json，不在此处

# 运行环境: dev | test | prod
AGENT_DRIVE_APP_ENV=dev

# 服务
AGENT_DRIVE_HOST=0.0.0.0
AGENT_DRIVE_PORT=8000

# Agent 参数
AGENT_DRIVE_MAX_STEPS=10
AGENT_DRIVE_CONTEXT_BUDGET=24000
AGENT_DRIVE_MAX_TOOL_OUTPUT=2000
AGENT_DRIVE_SUMMARIZE_THRESHOLD=12

# CORS（开发环境放开）
AGENT_DRIVE_CORS_ORIGINS=["*"]
