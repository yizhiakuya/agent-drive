# Agent Drive 环境配置（复制为 .env 使用）
# 注：LLM 的 API Key 由 Agent 自管理存于 system/agent-config.json，不在此处

# 运行环境: dev | test | prod
AGENT_DRIVE_APP_ENV=dev

# 服务
AGENT_DRIVE_HOST=0.0.0.0
AGENT_DRIVE_PORT=8000

# Agent 参数
AGENT_DRIVE_MAX_STEPS=10
AGENT_DRIVE_CONTEXT_WINDOW=262144
AGENT_DRIVE_CONTEXT_BUDGET=24000
AGENT_DRIVE_COMPRESS_THRESHOLD=0.6
AGENT_DRIVE_COMPRESS_KEEP_RECENT=8
AGENT_DRIVE_ROUNDTRIP_COMPRESS_THRESHOLD=0.9
AGENT_DRIVE_MAX_TOOL_OUTPUT=2000
AGENT_DRIVE_SUMMARIZE_THRESHOLD=12

# CORS（显式 origin，credentials 模式不允许 *；与代码默认值一致）
# - https://localhost：Capacitor App WebView 跨域（Bearer 鉴权）
# - http://localhost:3000：next dev 直连后端（Cookie 鉴权）
AGENT_DRIVE_CORS_ORIGINS=["https://localhost","http://localhost:3000","http://localhost"]

# 上传大小上限（MB）：公网闸门是 nginx client_max_body_size 200m，此为直连 8000 兜底
AGENT_DRIVE_MAX_UPLOAD_MB=300
