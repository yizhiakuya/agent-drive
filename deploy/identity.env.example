# Install as /etc/agent-drive-identity/identity.env with mode 0600.
# Do not enable the gateway adapter until identity data has been migrated.
IDENTITY_INTERNAL_TOKEN=replace-with-a-long-random-token
IDENTITY_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/agent_drive_identity
IDENTITY_DATABASE_USERNAME=agent_drive
IDENTITY_DATABASE_PASSWORD=replace-with-database-password
