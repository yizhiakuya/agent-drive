# Install as /etc/agent-drive-content/content.env with mode 0600.
# The main API passes the owner-scoped provider snapshot per request.
CONTENT_INTERNAL_TOKEN=replace-with-a-long-random-token
# Optional defaults for standalone health/probe use:
CONTENT_VISION_BASE_URL=
CONTENT_VISION_MODEL=
CONTENT_VISION_API_KEY=
CONTENT_MAX_IMAGES=4
CONTENT_MAX_IMAGE_BYTES=10485760
CONTENT_MAX_REQUEST_BYTES=83886080
CONTENT_MAX_RESPONSE_BYTES=2097152
