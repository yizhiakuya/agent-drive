[Unit]
Description=Agent Drive Java API and frontend SPA
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/agent-drive-java
ExecStart=/usr/bin/java -jar /opt/agent-drive-java/agent-drive-backend.jar --spring.profiles.active=db,java-chat --app.mode=api --server.address=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStartSec=120
TimeoutStopSec=60
SuccessExitStatus=143
EnvironmentFile=-/etc/agent-drive-java/java.env
Environment=AGENT_DRIVE_MODE=api
Environment=AGENT_DRIVE_FRONTEND_DIR=/root/projects/agent-drive/frontend/out
Environment=AGENT_DRIVE_DATA_DIR=/opt/agent-drive-java/data
EnvironmentFile=/etc/agent-drive/proxy.env
UnsetEnvironment=ALL_PROXY all_proxy
UMask=077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=read-only
MemoryMax=1G

[Install]
WantedBy=multi-user.target
