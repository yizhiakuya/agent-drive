# Install as /etc/agent-drive-index/index.env with mode 0600.
INDEX_INTERNAL_TOKEN=replace-with-a-long-random-token
INDEX_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/agent_drive_index
INDEX_DATABASE_USERNAME=agent_drive
INDEX_DATABASE_PASSWORD=replace-with-database-password
INDEX_DATABASE_NAME=agent_drive_index
