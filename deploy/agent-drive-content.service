[Unit]
Description=Agent Drive Content Intelligence Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/agent-drive-content
ExecStart=/usr/bin/java -jar /opt/agent-drive-content/content-service.jar --server.address=127.0.0.1
Restart=on-failure
RestartSec=3
TimeoutStartSec=90
TimeoutStopSec=30
SuccessExitStatus=143
EnvironmentFile=-/etc/agent-drive-content/content.env
EnvironmentFile=/etc/agent-drive/proxy.env
Environment=CONTENT_BIND_ADDRESS=127.0.0.1
Environment=CONTENT_PORT=8010
UnsetEnvironment=ALL_PROXY all_proxy
UMask=077
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=true
MemoryMax=768M

[Install]
WantedBy=multi-user.target
